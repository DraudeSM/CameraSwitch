<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CameraSwitch</AssemblyName>
    <ApplicationIcon>assets\CameraSwitch.ico</ApplicationIcon>
    <Version>1.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="obs-websocket-dotnet" Version="5.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\CameraSwitch.ico" LogicalName="CameraSwitch.ico" />
  </ItemGroup>

</Project>
